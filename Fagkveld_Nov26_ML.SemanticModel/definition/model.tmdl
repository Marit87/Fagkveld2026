model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: nb-NO
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["dim_customer","dim_date","dim_product","dim_store","fact_orders","fact_sales"]

annotation PBI_ProTooling = ["DevMode"]

ref table dim_customer
ref table dim_date
ref table dim_product
ref table dim_store
ref table fact_orders
ref table fact_sales

ref cultureInfo en-US

